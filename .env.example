# Required
TINYFISH_API_KEY=

# Persistence
# Local/development fallback:
RESEARCH_DB_PATH=research_state.db
# Production/shared deployment (recommended for Horizon and multi-replica hosting):
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional provider checks
ENABLE_CROSSREF_CHECKS=1
ENABLE_OPENALEX_CHECKS=0

# Optional runtime tuning
TINYFISH_SEARCH_RPM=30
TINYFISH_FETCH_URLS_RPM=150
TINYFISH_SEARCH_CONCURRENCY=8
TINYFISH_FETCH_CONCURRENCY=6
LOG_LEVEL=INFO
LOG_FORMAT=json
